 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# OpenMontage — Colab Stage 1 setup (fixed)\n",
    "This notebook runs the minimal Stage 1 validation on a Colab GPU runtime.\n",
    "It installs only the minimal dependencies, configures model caches, downloads required models, and runs the real Stage 1 smoke test.\n",
    "\n",
    "IMPORTANT: This notebook intentionally runs the real pipeline with OM_LOAD_ADAPTERS=1 and OM_REAL_STRICT=1. If any real adapter or model fails to load, the run will stop and report the failure.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1) Clone repository into /content (if not already present) and set repo_root\n",
    "import os, sys, subprocess\n",
    "repo_root = '/content/openmontage-colab'\n",
    "if not os.path.exists(repo_root):\n",
    "    print('Cloning repository into', repo_root)\n",
    "    subprocess.check_call(['git', 'clone', 'https://github.com/z3685507-tech/openmontage-colab.git', repo_root])\n",
    "else:\n",
    "    print('Repository already present at', repo_root)\n",
    "# ensure working directory is repo root for subsequent commands\n",
    "os.chdir(repo_root)\n",
    "print('CWD:', os.getcwd())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2) Environment and GPU detection (after cloning)\n",
    "import os, sys\n",
    "print('Python', sys.version)\n",
    "try:\n",
    "    import torch\n",
    "    print('torch', torch.__version__)\n",
    "    print('cuda available:', torch.cuda.is_available())\n",
    "    if torch.cuda.is_available():\n",
    "        try:\n",
    "            print('gpu name:', torch.cuda.get_device_name(0))\n",
    "            prop = torch.cuda.get_device_properties(0)\n",
    "            print('total memory (GB):', round(prop.total_memory / (1024**3),2))\n",
    "        except Exception as e:\n",
    "            print('GPU properties not available:', e)\n",
    "except Exception as e:\n",
    "    print('torch import failed or not installed:', e)\n",
    "# show nvidia-smi if available\n",
    "!nvidia-smi || true\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3) Install minimal dependencies with compatibility fixes\n",
    "# Fix setuptools to a compatible version for the provided torch wheel and install jedi for IPython\n",
    "print('Pinning setuptools and installing jedi before installing requirements')\n",
    "!pip -q install 'setuptools<82' jedi --upgrade\n",
    "!pip -q install -U pip wheel\n",
    "# Now install repository's minimal requirements (requirements-colab.txt is in repo root)\n",
    "import pathlib\n",
    "req = pathlib.Path('requirements-colab.txt')\n",
    "if req.exists():\n",
    "    print('Installing from', req)\n",
    "    # Install but allow pip to skip incompatible torch if necessary (Colab provides torch GPU build).\n",
    "    !pip -q install -r requirements-colab.txt || pip -q install --no-deps -r requirements-colab.txt\n",
    "else:\n",
    "    print('requirements-colab.txt not found — installing a minimal fallback set')\n",
    "    !pip -q install transformers accelerate safetensors huggingface_hub diffusers ffmpeg-python soundfile moviepy\n",
    "# Ensure ffmpeg binary available\n",
    "!apt-get -qq update && apt-get -qq install -y ffmpeg || true\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4) Prepare PYTHONPATH and Hugging Face cache locations\n",
    "import os\n",
    "os.environ['PYTHONPATH'] = repo_root + ':' + os.environ.get('PYTHONPATH','')\n",
    "os.environ['HF_HOME'] = os.path.join(repo_root, 'hf_cache')\n",
    "os.environ['TRANSFORMERS_CACHE'] = os.path.join(repo_root, 'hf_cache')\n",
    "print('PYTHONPATH set to', os.environ['PYTHONPATH'])\n",
    "print('HF cache:', os.environ['HF_HOME'])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5) Enable strict real-mode and adapter importing for real Stage 1 validation\n",
    "import os\n",
    "os.environ['OM_LOAD_ADAPTERS'] = '1'\n",
    "os.environ['OM_REAL_STRICT'] = '1'\n",
    "print('OM_LOAD_ADAPTERS, OM_REAL_STRICT set')\n"
    # Ensure registry prefers a real image adapter (qwen-image) so strict runs select a real adapter
    try:
        from src.registry import load_registry
        reg = load_registry()
        if 'image_generation' in reg.data:
            reg.data['image_generation']['default_choice'] = 'qwen-image'
            models = reg.data['image_generation'].get('models', [])
            models_sorted = sorted(models, key=lambda m: 0 if m.get('id') == 'qwen-image' else 1)
            reg.data['image_generation']['models'] = models_sorted
            print("Registry override: image_generation.default_choice set to qwen-image for this session")
    except Exception as e:
        print('Registry override failed (will try default config):', e)\n"   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6) Optional: prefetch small required files or model shims if known (best-effort)\n",
    "from pathlib import Path\n",
    "models_dir = Path('/content/models')\n",
    "models_dir.mkdir(exist_ok=True)\n",
    "print('models_dir:', models_dir)\n",
    "print('NOTE: Model downloads can be large. The smoke run will stop and report if a model fails to load.')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7) Run Stage 1 smoke script (real run). This will stop if a required adapter or model is missing.\n",
    "import os, sys, subprocess\n",
    "os.environ['PYTHONPATH'] = repo_root + ':' + os.environ.get('PYTHONPATH','')\n",
    "print('Running smoke script with OM_LOAD_ADAPTERS=1 and OM_REAL_STRICT=1')\n",
    "# Use check_call so exceptions propagate and stop the notebook if strict mode fails\n",
    "try:\n",
    "    subprocess.check_call([sys.executable, 'tools/run_stage1_smoke.py'], cwd=repo_root)\n",
    "    print('smoke script completed')\n",
    "except subprocess.CalledProcessError as e:\n",
    "    print('Smoke script failed with exit code', e.returncode)\n",
    "    raise\n",
    "except FileNotFoundError as e:\n",
    "    print('Smoke script not found or repo path incorrect:', e)\n",
    "    raise\n"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Notes\n",
    "- The notebook sets OM_LOAD_ADAPTERS=1 and OM_REAL_STRICT=1 to ensure real adapters are loaded and missing adapters cause an immediate failure.\n",
    "- If any model is too large for the available VRAM, reduce the model selection in configs/models.yaml or use a smaller variant.\n",
    "- The smoke script writes a report to projects/smoke-report/artifacts/smoke_report.json inside the repo.\n",
    "- After the run finishes (or fails), paste the contents of projects/smoke-report/artifacts/smoke_report.json here for analysis.\n"
   ]
  }
