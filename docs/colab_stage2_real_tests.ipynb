   "source": [
    "# OpenMontage Stage 2: Real-model validation cells\n",
    "\n",
    "Priority order:\n",
    "1) Real TTS (CosyVoiceTTS)\n",
    "2) Real Transcription (Faster-Whisper)\n",
    "3) Real Music (MusicGen short clip)\n",
    "\n",
    "Each section installs only required dependencies, performs one real inference on GPU (if available), and writes diagnostics to projects/smoke-report/artifacts/real_init.log.\n",
    "DO NOT run the full Stage 1 pipeline from this notebook. Each cell prints PASS/FAIL and a short report.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Cell A: Setup + ensure repo on refactor/colab-ready\n",
    "import os, sys, subprocess\n",
    "REPO_DIR = '/content/openmontage-colab'\n",
    "if os.path.exists(REPO_DIR):\n",
    "    subprocess.run(['bash','-lc', f'cd {REPO_DIR} && git fetch --all && git checkout refactor/colab-ready && git pull origin refactor/colab-ready'], check=False)\n",
    "else:\n",
    "    subprocess.run(['bash','-lc', f'git clone https://github.com/jvvghj123-sudo/openmontage-colab.git {REPO_DIR}'], check=True)\n",
    "    subprocess.run(['bash','-lc', f'cd {REPO_DIR} && git checkout refactor/colab-ready'], check=False)\n",
    "sys.path.insert(0, REPO_DIR)\n",
    "os.environ['OM_LOAD_ADAPTERS'] = '1'\n",
    "print('Repository ready:', REPO_DIR)\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Cell 1: Real TTS — install minimal deps and run one real synthesis\n",
    "import os, time, json, traceback\n",
    "art = os.path.join('projects','smoke-report','artifacts')\n",
    "os.makedirs(art, exist_ok=True)\n",
    "def append_log(payload):\n",
    "    with open(os.path.join(art,'real_init.log'),'a',encoding='utf-8') as f:\n",
    "        f.write(json.dumps(payload)+"\\n")\n",
    "# Install system and python deps needed for pyttsx3 fallback if cosyvoice unavailable\n",
    "print('Installing TTS dependencies (apt + pip)...')\n",
    "# minimize installs: try cosyvoice pip first (if it exists), else install pyttsx3 + espeak\n",
    "ok = True\n",
    "try:\n",
    "    # In Colab you may run shell pip directly; here we try subprocess to be portable\n",
    "    import subprocess\n",
    "    subprocess.run(['pip','-q','install','cosyvoice'], check=False)\n",
    "except Exception:\n",
    "    pass\n",
    "# install pyttsx3 + scipy for fallback audio saving\n",
    "try:\n",
    "    subprocess.run(['apt-get','-y','-qq','update'], check=False)\n",
    "    subprocess.run(['apt-get','-y','-qq','install','espeak','libespeak-dev','ffmpeg'], check=False)\n",
    "except Exception:\n",
    "    pass\n",
    "try:\n",
    "    subprocess.run(['pip','-q','install','pyttsx3','scipy','numpy'], check=False)\n",
    "except Exception:\n",
    "    pass\n",
    "print('Done installs — attempting to instantiate CosyVoiceTTS adapter')\n",
    "from src.adapters.adapter_loader import get_component, MODEL_TO_ADAPTER\n",
    "from src.registry import load_registry\n",
    "reg = load_registry().data\n",
    "choice = reg.get('tts',{}).get('default_choice')\n",
    "mapping = MODEL_TO_ADAPTER.get(choice)\n",
    "payload = {'event':'stage2_real_tts','choice':choice,'mapping':mapping}\n",
    "try:\n",
    "    comp = get_component('tts', profile='balanced')\n",
    "    payload['instantiated'] = comp is not None\n",
    "    if comp is None:\n",
    "        payload['status']='no_adapter'\n",
    "        append_log(payload); print('No TTS adapter instantiated — FAIL'); raise SystemExit('No adapter')\n",
    "    print('Adapter class:', comp.__class__.__name__, 'available=', getattr(comp,'available',None))\n",
    "    # Attempt a short real synthesis (one sentence) — will use cosyvoice if installed, else pyttsx3 fallback (may still be real audio)\n",
    "    sample_text = 'This is a short real TTS validation test.'\n",
    "    out_path = os.path.join('projects','colab-stage2-test','tts_real.wav')\n",
    "    os.makedirs(os.path.dirname(out_path), exist_ok=True)\n",
    "    t0 = time.time()\n",
    "    res = comp.run(sample_text, output=out_path)\n",
    "    t1 = time.time()\n",
    "    payload['result'] = res\n",
    "    payload['time_s'] = round(t1-t0,2)\n",
    "    # validate output file exists and seems non-empty\n",
    "    ok = os.path.exists(out_path) and os.path.getsize(out_path) > 2000\n",
    "    payload['output_exists'] = os.path.exists(out_path)\n",
    "    payload['output_size'] = os.path.getsize(out_path) if os.path.exists(out_path) else 0\n",
    "    if ok:\n",
    "        payload['status']='PASS'\n",
    "        print('REAL TTS: PASS — audio written to', out_path, 'time_s=', payload['time_s'])\n",
    "    else:\n",
    "        payload['status']='FAIL'\n",
    "        print('REAL TTS: FAIL — output missing or too small; reported result:', res)\n",
    "    append_log(payload)\n",
    "except Exception as e:\n",
    "    payload['status']='ERROR'\n",
    "    payload['error']=str(e)\n",
    "    payload['traceback']=traceback.format_exc()\n",
    "    append_log(payload)\n",
    "    print('REAL TTS: ERROR', e)\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Cell 2: Real Transcription — install faster-whisper + ctranslate2 minimal and test on a real short speech clip\n",
    "import os, time, json, traceback\n",
    "art = os.path.join('projects','smoke-report','artifacts')\n",
    "os.makedirs(art, exist_ok=True)\n",
    "print('Installing faster-whisper and dependencies (may take a minute)')\n",
    "# Install faster-whisper and CTranslate2 (GPU-enabled if CUDA present)\n",
    "try:\n",
    "    import subprocess\n",
    "    subprocess.run(['pip','-q','install','faster-whisper'], check=False)\n",
    "    subprocess.run(['pip','-q','install','ctranslate2'], check=False)\n",
    "    subprocess.run(['pip','-q','install','git+https://github.com/openai/whisper.git'], check=False)\n",
    "except Exception:\n",
    "    pass\n",
    "print('Installs done — preparing audio sample')\n",
    "# Use a short spoken sample — prefer a user-provided file; fall back to a small public speech clip or generated TTS if needed\n",
    "sample_dir = 'projects/colab-stage2-test'\n",
    "os.makedirs(sample_dir, exist_ok=True)\n",
    "sample_path = os.path.join(sample_dir,'sample_speech.wav')\n",
    "# Try to download a tiny CC0 spoken sample if internet allowed; else attempt to synthesize short phrase via pyttsx3 to create a real speech sample\n",
    "if not os.path.exists(sample_path):\n",
    "    try:\n",
    "        import requests\n",
    "        url = 'https://www2.cs.uic.edu/~i101/SoundFiles/StarWars3.wav'\n",
    "        r = requests.get(url, timeout=15)\n",
    "        open(sample_path,'wb').write(r.content)\n",
    "        print('Downloaded sample to', sample_path)\n",
    "    except Exception as e:\n",
    "        print('Download failed, synthesizing via pyttsx3 fallback')\n",
    "        try:\n",
    "            import pyttsx3\n",
    "            import numpy as np\n",
    "            import scipy.io.wavfile as wavfile\n",
    "            engine = pyttsx3.init()\n",
    "            tmp = os.path.join(sample_dir,'tmp_tts.wav')\n",
    "            engine.save_to_file('This is a short test sentence for transcription.', tmp)\n",
    "            engine.runAndWait()\n",
    "            if os.path.exists(tmp):\n",
    "                os.rename(tmp, sample_path)\n",
    "                print('Synthesized sample at', sample_path)\n",
    "        except Exception as se:\n",
    "            print('Failed to synthesize sample for transcription:', se)\n",
    "# Now instantiate faster-whisper adapter with small model to avoid large downloads\n",
    "from src.adapters import adapter_loader\n",
    "mapping = adapter_loader.MODEL_TO_ADAPTER.get('faster-whisper')\n",
    "payload = {'event':'stage2_real_transcription','choice':'faster-whisper','mapping':mapping}\n",
    "try:\n",
    "    mod_name, cls_name = mapping\n",
    "    mod = __import__(f'src.adapters.{mod_name}', fromlist=['*'])\n",
    "    cls = getattr(mod, cls_name)\n",
    "    inst = cls('faster-whisper', config={'model':'small'})\n",
    "    payload['instantiated'] = True\n",
    "    payload['available'] = getattr(inst,'available',None)\n",
    "    if not getattr(inst,'available',False):\n",
    "        payload['status']='NOT_AVAILABLE'\n",
    "        append_log(payload); print('Transcriber unavailable locally — FAIL'); raise SystemExit('unavailable')\n",
    "    print('Transcriber backend ready — running transcription')\n",
    "    t0 = time.time()\n",
    "    res = inst.run(sample_path)\n",
    "    t1 = time.time()\n",
    "    payload['time_s'] = round(t1-t0,2)\n",
    "    payload['result_snippet'] = (res.get('transcript') or '')[:200]\n",
    "    payload['status']='PASS'\n",
    "    append_log(payload)\n",
    "    print('REAL TRANSCRIPTION: PASS — transcript:', payload['result_snippet'])\n",
    "except Exception as e:\n",
    "    payload['status']='ERROR'\n",
    "    payload['error']=str(e)\n",
    "    payload['traceback']=traceback.format_exc()\n",
    "    append_log(payload)\n",
    "    print('REAL TRANSCRIPTION: ERROR', e)\n"
   ]
  },
  {
   "cell_type": "code",
