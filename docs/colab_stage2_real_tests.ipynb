   "source": [
    "# Cell 3: Real MusicGen short generation (very short duration)\n",
    "import os, time, json, traceback\n",
    "art = os.path.join('projects','smoke-report','artifacts')\n",
    "os.makedirs(art, exist_ok=True)\n",
    "print('Installing music dependencies for MusicGen (transformers, soundfile) — may take a minute')\n",
    "try:\n",
    "    import subprocess\n",
    "    subprocess.run(['pip','-q','install','transformers','soundfile','git+https://github.com/facebookresearch/audiocraft'], check=False)\n",
    "except Exception:\n",
    "    pass\n",
    "print('Installs done — instantiating MusicGen adapter with a small model if supported')\n",
    "from src.adapters import adapter_loader\n",
    "mapping = adapter_loader.MODEL_TO_ADAPTER.get('musicgen')\n",
    "payload = {'event':'stage2_real_music','choice':'musicgen','mapping':mapping}\n",
    "try:\n",
    "    mod_name, cls_name = mapping\n",
    "    mod = __import__(f'src.adapters.{mod_name}', fromlist=['*'])\n",
    "    cls = getattr(mod, cls_name)\n",
    "    # attempt to use a short/smaller model if adapter supports config override\n",
    "    inst = cls('musicgen', config={'model':'facebook/musicgen-small'})\n",
    "    payload['instantiated'] = True\n",
    "    payload['available'] = getattr(inst,'available',None)\n",
    "    if not getattr(inst,'available',False):\n",
    "        payload['status']='NOT_AVAILABLE'\n",
    "        append_log(payload); print('MusicGen adapter not available — FAIL'); raise SystemExit('not available')\n",
    "    # run a very short generation (e.g., 3s)\n",
    "    out_dir = 'projects/colab-stage2-test'\n",
    "    os.makedirs(out_dir, exist_ok=True)\n",
    "    t0 = time.time()\n",
    "    if hasattr(inst,'generate_music'):\n",
    "        res = inst.generate_music('Short ambient test', duration=3)\n",
    "    else:\n",
    "        res = inst.generate('Short ambient test', duration=3)\n",
    "    t1 = time.time()\n",
    "    payload['time_s'] = round(t1-t0,2)\n",
    "    payload['result'] = res\n",
    "    # verify audio exists if adapter returns output_path\n",
    "    out_path = res.get('output_path') if isinstance(res, dict) else None\n",
    "    payload['output_path'] = out_path\n",
    "    ok = out_path and os.path.exists(out_path) and os.path.getsize(out_path) > 2000\n",
    "    if ok:\n",
    "        payload['status']='PASS'\n",
    "        append_log(payload); print('REAL MUSIC: PASS — audio at', out_path, 'time_s', payload['time_s'])\n",
    "    else:\n",
    "        payload['status']='FAIL'\n",
    "        append_log(payload); print('REAL MUSIC: FAIL — result:', res)\n",
    "except Exception as e:\n",
    "    payload['status']='ERROR'\n",
    "    payload['error']=str(e)\n",
    "    payload['traceback']=traceback.format_exc()\n",
    "    append_log(payload)\n",
    "    print('REAL MUSIC: ERROR', e)\n"
   ]
  },
